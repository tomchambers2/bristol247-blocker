{
  "manifest_version": 3,
  "name": "Bristol247 Comment Blocker",
  "version": "1.1",
  "description": "Blocks comments on bristol247.com",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://*.bristol247.com/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [{
    "resources": ["css/hide-comments.css"],
    "matches": ["<all_urls>"]
  }]
}
